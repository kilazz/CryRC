// Copyright 2001-2026 Crytek GmbH / Crytek Group. All rights reserved.
// CryTIF Plugin Main Dialog Window with Balanced 50/50 Dual Viewports and Mipmap Inspection

import { Theme } from "theme.slint";
import { SvgZoomIn, SvgZoomOut } from "icons.slint";
import { CustomCheckBox } from "controls.slint";
import { TextureViewport } from "viewports.slint";
import { PresetSidebar } from "preset_sidebar.slint";
import { ConfigTabs } from "config_tabs.slint";
import { Button, ComboBox } from "std-widgets.slint";

export component CryTifDialog inherits Window {
    title: "CryTIF Plugin - Texture Export Settings (Rust Edition)";
    preferred-width: 1220px;
    preferred-height: 760px;
    min-width: 1100px;
    min-height: 680px;
    background: Theme.bg-main;

    in-out property <bool> dark-theme <=> Theme.dark;

    // Previews & Info
    in property <image> source-preview;
    in property <image> target-preview;
    in property <string> source-info: "2048x2048 Fmt: A8R8G8B8";
    in property <string> target-info: "2048x2048 Mips: 9 Fmt: BC1 Mdl: sRGB (2048 KB)";
    in property <[string]> presets;
    in-out property <int> selected-preset-index: 0;
    in-out property <string> current-preset: "Albedo";
    in-out property <bool> list-all-presets: true;

    // Viewport Controls & Dynamic Helper Text
    in-out property <bool> preview-on: true;
    in-out property <bool> tiled-preview: false;
    in-out property <bool> bilinear-filter: true;
    in-out property <int> channel-mode-index: 0;
    in-out property <string> channel-mode-desc: "Normal RGB preview mode (alpha channel ignored)";
    in-out property <int> zoom-percent: 100;
    in-out property <int> mip-level: 0;
    in property <int> mip-count: 1;

    // Tab 1: Resolution & Platforms
    in-out property <bool> suppress-engine-reduce: false;
    in-out property <bool> split-streaming: false;
    in-out property <int> persistent-mips-index: 2;
    in-out property <int> max-size-index: 0;
    in-out property <int> selected-platform-idx: 0;
    in property <string> pc-res-info: "2048 x 2048 (BC1)";
    in property <string> ps4-res-info: "2048 x 2048 (BC1)";
    in property <string> xbox-res-info: "2048 x 2048 (BC1)";
    in property <string> mobile-res-info: "1024 x 1024 (ETC2)";

    // Tab 2: MIP Control
    in-out property <bool> generate-mips: true;
    in-out property <bool> maintain-alpha-coverage: false;
    in-out property <int> mip-filter-index: 0;
    in-out property <float> mip1-adjust: 50.0;
    in-out property <float> mip2-adjust: 50.0;
    in-out property <float> mip3-adjust: 50.0;
    in-out property <float> mip4-adjust: 50.0;
    in-out property <float> mip5-adjust: 50.0;
    in-out property <float> mip6-adjust: 50.0;

    // Tab 3: RGB to Normal
    in-out property <int> rgb-bump-type: 0;
    in-out property <float> rgb-bump-strength: 5.0;
    in-out property <float> rgb-bump-blur: 0.0;
    in-out property <bool> rgb-bump-invert: false;

    // Tab 4: A to Normal
    in-out property <int> alpha-bump-type: 0;
    in-out property <float> alpha-bump-strength: 5.0;
    in-out property <float> alpha-bump-blur: 0.0;
    in-out property <bool> alpha-bump-invert: false;

    // Tab 5: RDO & Formats
    in-out property <float> rdo-lambda: 0.0;
    in-out property <bool> rdo-ultrasmooth: true;
    in-out property <int> rdo-lookback-index: 2;
    in-out property <int> quality-index: 2;
    in-out property <int> colorspace-index: 0;
    in-out property <int> format-override-index: 0;
    in-out property <bool> dither: false;
    in-out property <bool> discard-alpha: false;

    // Selected Preset Info
    in-out property <string> preset-info-text: "";

    // Callbacks
    callback ok-clicked();
    callback cancel-clicked();
    callback generate-clicked();
    callback preset-selected(string);
    callback list-all-toggled(bool);
    callback settings-changed();
    callback higher-res-clicked(int);
    callback lower-res-clicked(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // --- 1. Top Header Bar ---
        HorizontalLayout {
            alignment: space-between;
            height: 24px;

            Text {
                text: "CryTIF Texture Export";
                font-size: 13px;
                font-weight: 700;
                font-family: "Segoe UI";
                color: Theme.text-main;
                vertical-alignment: center;
            }
        }

        // =========================================================================
        // 2. MAIN 3-COLUMN WORKSPACE
        // =========================================================================
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            // --- COLUMN 1: Texture Previews ---
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;

                // Dual Viewports with Strict Equal Split
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;

                    TextureViewport {
                        horizontal-stretch: 1;
                        title: "Original (Source)";
                        info: root.source-info;
                        preview: root.source-preview;
                        bilinear-filter: root.bilinear-filter;
                    }

                    TextureViewport {
                        horizontal-stretch: 1;
                        title: "Compressed (Target)";
                        info: root.target-info;
                        preview: root.target-preview;
                        bilinear-filter: root.bilinear-filter;
                    }
                }

                // Bottom Viewport Controls Toolbar
                Rectangle {
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 5px;
                    height: 48px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: space-between;

                            // Left Controls Group
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    CustomCheckBox {
                                        text: "On";
                                        checked <=> root.preview-on;
                                        toggled => { root.settings-changed(); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    CustomCheckBox {
                                        text: "Tiled";
                                        checked <=> root.tiled-preview;
                                        toggled => { root.settings-changed(); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    CustomCheckBox {
                                        text: "Bilinear";
                                        checked <=> root.bilinear-filter;
                                        toggled => { root.settings-changed(); }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Channel Mode:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            font-family: "Segoe UI";
                                            color: Theme.text-main;
                                            vertical-alignment: center;
                                        }

                                        ComboBox {
                                            model: [
                                                "RGB",
                                                "Alpha",
                                                "RGB Alpha",
                                                "Debug Normals",
                                                "AlphaTestBlend",
                                                "AlphaTestNoBlend",
                                                "mCIE2RGB"
                                            ];
                                            current-index <=> root.channel-mode-index;
                                            selected(val) => { root.settings-changed(); }
                                            width: 145px;
                                        }
                                    }
                                }
                            }

                            // Right Mip & Zoom Controls Group
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;

                                // Mip Controls
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: "MIP:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            font-family: "Segoe UI";
                                            color: Theme.text-main;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            background: Theme.card-alt;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            border-radius: 3px;
                                            height: 24px;
                                            clip: true;
                                            HorizontalLayout {
                                                Rectangle {
                                                    width: 24px;
                                                    background: Theme.btn-bg;
                                                    Text {
                                                        text: "-";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Theme.text-main;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }

                                                    TouchArea {
                                                        clicked => {
                                                            root.mip-level = max(0, root.mip-level - 1);
                                                            root.settings-changed();
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 1px;
                                                    background: Theme.border;
                                                }

                                                Rectangle {
                                                    width: 32px;
                                                    Text {
                                                        text: "\{root.mip-level}";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Theme.text-main;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 1px;
                                                    background: Theme.border;
                                                }

                                                Rectangle {
                                                    width: 24px;
                                                    background: Theme.btn-bg;
                                                    Text {
                                                        text: "+";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: Theme.text-main;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }

                                                    TouchArea {
                                                        clicked => {
                                                            root.mip-level = min(root.mip-count - 1, root.mip-level + 1);
                                                            root.settings-changed();
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Zoom Controls
                                VerticalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;

                                        Text {
                                            text: "Zoom:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            font-family: "Segoe UI";
                                            color: Theme.text-main;
                                            vertical-alignment: center;
                                        }

                                        // Zoom Out Button
                                        Rectangle {
                                            width: 26px;
                                            height: 24px;
                                            background: Theme.btn-bg;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            border-radius: 3px;

                                            VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    SvgZoomOut {
                                                        icon-color: Theme.text-main;
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                clicked => { root.zoom-out(); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Zoom In Button
                                        Rectangle {
                                            width: 26px;
                                            height: 24px;
                                            background: Theme.btn-bg;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            border-radius: 3px;

                                            VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    SvgZoomIn {
                                                        icon-color: Theme.text-main;
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                clicked => { root.zoom-in(); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Percentage Label Box
                                        Rectangle {
                                            background: Theme.card-alt;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            border-radius: 3px;
                                            height: 24px;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                Text {
                                                    text: "\{root.zoom-percent}%";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    font-family: "Segoe UI";
                                                    color: Theme.text-main;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 1:1 Reset Button
                                        Rectangle {
                                            width: 30px;
                                            height: 24px;
                                            background: Theme.btn-bg;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            border-radius: 3px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "1:1";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    font-family: "Segoe UI";
                                                    color: Theme.text-main;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                clicked => { root.zoom-reset(); }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.channel-mode-desc;
                            font-size: 10px;
                            font-family: "Segoe UI";
                            color: Theme.text-muted;
                        }
                    }
                }
            }

            // --- COLUMN 2: Settings Inspector ---
            ConfigTabs {
                width: 320px;
                suppress-engine-reduce <=> root.suppress-engine-reduce;
                split-streaming <=> root.split-streaming;
                persistent-mips-index <=> root.persistent-mips-index;
                max-size-index <=> root.max-size-index;
                selected-platform-idx <=> root.selected-platform-idx;
                pc-res-info: root.pc-res-info;
                ps4-res-info: root.ps4-res-info;
                xbox-res-info: root.xbox-res-info;
                mobile-res-info: root.mobile-res-info;

                generate-mips <=> root.generate-mips;
                maintain-alpha-coverage <=> root.maintain-alpha-coverage;
                mip-filter-index <=> root.mip-filter-index;
                mip1-adjust <=> root.mip1-adjust;
                mip2-adjust <=> root.mip2-adjust;
                mip3-adjust <=> root.mip3-adjust;
                mip4-adjust <=> root.mip4-adjust;
                mip5-adjust <=> root.mip5-adjust;
                mip6-adjust <=> root.mip6-adjust;

                rgb-bump-type <=> root.rgb-bump-type;
                rgb-bump-strength <=> root.rgb-bump-strength;
                rgb-bump-blur <=> root.rgb-bump-blur;
                rgb-bump-invert <=> root.rgb-bump-invert;

                alpha-bump-type <=> root.alpha-bump-type;
                alpha-bump-strength <=> root.alpha-bump-strength;
                alpha-bump-blur <=> root.alpha-bump-blur;
                alpha-bump-invert <=> root.alpha-bump-invert;

                rdo-lambda <=> root.rdo-lambda;
                rdo-ultrasmooth <=> root.rdo-ultrasmooth;
                rdo-lookback-index <=> root.rdo-lookback-index;
                quality-index <=> root.quality-index;
                colorspace-index <=> root.colorspace-index;
                format-override-index <=> root.format-override-index;
                dither <=> root.dither;
                discard-alpha <=> root.discard-alpha;

                settings-changed => { root.settings-changed(); }
                higher-res-clicked(idx) => { root.higher-res-clicked(idx); }
                lower-res-clicked(idx) => { root.lower-res-clicked(idx); }
            }

            // --- COLUMN 3: Presets & Live Property Inspector ---
            PresetSidebar {
                width: 300px;
                presets: root.presets;
                selected-preset-index <=> root.selected-preset-index;
                current-preset <=> root.current-preset;
                list-all-presets <=> root.list-all-presets;
                preset-info-text: root.preset-info-text;

                preset-selected(preset-name) => {
                    root.preset-selected(preset-name);
                }
                list-all-toggled(show-all) => {
                    root.list-all-toggled(show-all);
                }
            }
        }

        // =========================================================================
        // 3. BOTTOM FOOTER ACTION BAR
        // =========================================================================
        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Rectangle {
                width: 130px;
                height: 28px;
                background: Theme.btn-bg;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Generate Output";
                        font-size: 11px;
                        font-weight: 700;
                        font-family: "Segoe UI";
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.generate-clicked(); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 85px;
                height: 28px;
                background: Theme.accent;
                border-radius: 4px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "OK";
                        font-size: 12px;
                        font-weight: 700;
                        font-family: "Segoe UI";
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.ok-clicked(); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                width: 75px;
                height: 28px;
                background: Theme.btn-bg;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Cancel";
                        font-size: 11px;
                        font-weight: 700;
                        font-family: "Segoe UI";
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.cancel-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
