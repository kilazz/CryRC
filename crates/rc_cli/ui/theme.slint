// Unified Medium Studio Slate Theme (R=G=B, Zero Blue, DCC Standard)

export global Theme {
    in-out property <bool> dark: true;

    // Pure Neutral Studio Palette (R == G == B)
    out property <color> bg-main: #252528;
    out property <color> card: #2f3036;
    out property <color> card-alt: #1e1f23;
    out property <color> border: #42444e;
    out property <color> border-subtle: #34363e;
    out property <color> text-main: #f5f6f8;
    out property <color> text-muted: #a2a5b2;
    out property <color> btn-bg: #3a3c45;
    out property <color> btn-hover: #484b57;
    out property <color> accent: #ff5442;
    out property <color> accent-hover: #ff6c5c;
}
