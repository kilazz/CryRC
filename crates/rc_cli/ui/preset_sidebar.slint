// Wide Preset Selector & Resizable Code-Editor Parameter Inspector Sidebar

import { Theme } from "theme.slint";
import { CustomCheckBox } from "controls.slint";
import { ScrollView } from "std-widgets.slint";

export component PresetSidebar inherits Rectangle {
    in property <[string]> presets;
    in-out property <int> selected-preset-index: 0;
    in-out property <string> current-preset: "Albedo";
    in-out property <bool> list-all-presets: true;
    in property <string> preset-info-text: "";

    // Adjustable Inspector Height (drag splitter to resize)
    in-out property <length> inspector-height: 280px;

    callback preset-selected(string);
    callback list-all-toggled(bool);

    width: 300px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;
    clip: true;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // --- 1. Sidebar Header ---
        HorizontalLayout {
            alignment: space-between;
            height: 22px;

            Text {
                text: "Presets (rc.ini)";
                font-size: 12px;
                font-weight: 700;
                font-family: "Segoe UI";
                color: Theme.text-main;
                vertical-alignment: center;
            }

            CustomCheckBox {
                text: "All";
                checked <=> root.list-all-presets;
                toggled => {
                    root.list-all-toggled(root.list-all-presets);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // --- 2. Presets List View (Flex Height) ---
        Rectangle {
            vertical-stretch: 1;
            background: Theme.card-alt;
            border-radius: 4px;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 3px;
                    spacing: 1px;

                    for preset-item[idx] in root.presets: Rectangle {
                        height: 23px;
                        background: (root.current-preset == preset-item) ? Theme.btn-hover : #00000000;
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 6px;
                            alignment: start;

                            if root.current-preset == preset-item: HorizontalLayout {
                                alignment: center;
                                width: 3px;
                                Rectangle {
                                    width: 3px;
                                    height: 13px;
                                    background: Theme.accent;
                                    border-radius: 1px;
                                }
                            }

                            Text {
                                text: preset-item;
                                font-size: 11px;
                                font-weight: (root.current-preset == preset-item) ? 700 : 500;
                                font-family: "Segoe UI";
                                color: (preset-item == "------------------------------------------------") ? Theme.text-muted : Theme.text-main;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                if preset-item != "------------------------------------------------" {
                                    root.current-preset = preset-item;
                                    root.selected-preset-index = idx;
                                    root.preset-selected(preset-item);
                                }
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }

        // --- 3. Interactive Draggable Splitter ---
        Rectangle {
            height: 7px;
            background: splitter-touch.has-hover ? Theme.accent : transparent;
            border-radius: 2px;

            // Visual Grip Handle
            Rectangle {
                width: 36px;
                height: 3px;
                background: splitter-touch.has-hover ? #ffffff : Theme.border;
                border-radius: 1px;
            }

            splitter-touch := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    // Drag upwards to expand inspector, downwards to shrink
                    root.inspector-height = max(100px, min(root.height - 120px, root.inspector-height - (self.mouse-y - self.pressed-y)));
                }
            }
        }

        // --- 4. Code-Editor Style Parameter Inspector ---
        Rectangle {
            height: root.inspector-height;
            background: #18191c; // Darker IDE editor background
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 18px;

                    Text {
                        text: "Preset: \{root.current-preset}";
                        font-size: 11px;
                        font-weight: 700;
                        font-family: "Segoe UI";
                        color: Theme.accent;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Strict Left-Aligned Code Editor View
                ScrollView {
                    HorizontalLayout {
                        alignment: start;
                        padding-left: 2px;
                        padding-top: 2px;

                        Text {
                            text: root.preset-info-text;
                            font-size: 11px;
                            font-family: "Consolas";
                            color: #e2e4ec;
                            horizontal-alignment: left;
                        }
                    }
                }
            }
        }
    }
}
